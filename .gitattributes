* text=auto eol=lf
*.cmd text eol=crlf
*.png binary
*.pdf binary
# Printed templates and design sources must retain their exact bytes and hashes.
output/** -text -whitespace
# HTTP snapshots must retain their exact bytes for recorded SHA-256 checks.
data/sources/** -text -whitespace
# Hardware snapshots and export tables are byte-checksummed audit artifacts.
# Keep their exact bytes so a checkout does not invalidate recorded SHA-256.
hardware/nfc-talisman/eda/native/** -text -whitespace
hardware/nfc-talisman/eda/check-summary.json -text -whitespace
hardware/nfc-talisman/eda/core-pads.json -text -whitespace
hardware/nfc-talisman/electrical/*candidate.json -text -whitespace
hardware/nfc-talisman/electrical/*audit.json -text -whitespace
hardware/nfc-talisman/electrical/antenna-geometry-review.json -text -whitespace
hardware/nfc-talisman/electrical/via-size-review.json -text -whitespace
hardware/nfc-talisman/electrical/BOM.csv -text -whitespace
hardware/nfc-talisman/manufacturing/draft/** -text -whitespace
hardware/nfc-talisman/manufacturing/bom-ready.csv -text -whitespace
hardware/nfc-talisman/manufacturing/bom-review.md -text -whitespace
# Reference collection files are byte-checksummed, including generated vectors.
hardware/nfc-talisman/artwork/reference-collection/** -text -whitespace
# Review studies and first-article records also carry exact file hashes.
hardware/nfc-talisman/artwork/production-study-v1/** -text -whitespace
hardware/nfc-talisman/manufacturing/first-article-v1/** -text -whitespace
hardware/nfc-talisman/manufacturing/bom-erc-closeout-v1/** -text -whitespace
hardware/nfc-talisman/manufacturing/improvement-review-v1/** -text -whitespace
hardware/nfc-talisman/manufacturing/star-led-review-v1/** -text -whitespace
hardware/nfc-talisman/artwork/star-style-study-v1/** -text -whitespace
hardware/nfc-talisman/variants/** -text -whitespace
